from typing import List

class Solution:
    def uniquePaths(self, grid: List[List[int]]) -> int:
        MOD = 10**9 + 7
        m, n = len(grid), len(grid[0])
        jump = [[[( -1, -1 ) for _ in range(2)] for _ in range(n)] for _ in range(m)]
        for r in range(m - 1, -1, -1):
            for c in range(n - 1, -1, -1):
                if grid[r][c] == 0:
                    jump[r][c][0] = (r, c)
                    jump[r][c][1] = (r, c)
                else:
                    if r + 1 < m:
                        jump[r][c][0] = jump[r + 1][c][1]

                    if c + 1 < n:
                        jump[r][c][1] = jump[r][c + 1][0]

        dp = [[0] * n for _ in range(m)]
        dp[0][0] = 1  # Starting point
        
        for r in range(m):
            for c in range(n):
                if dp[r][c] == 0 or grid[r][c] == 1:
                    continue
                if c + 1 < n:
                    nr, nc = jump[r][c + 1][0]
                    if nr != -1:
                        dp[nr][nc] = (dp[nr][nc] + dp[r][c]) % MOD
                        
                if r + 1 < m:
                    nr, nc = jump[r + 1][c][1]
                    if nr != -1:  
                        dp[nr][nc] = (dp[nr][nc] + dp[r][c]) % MOD
                        
        return dp[m - 1][n - 1]
